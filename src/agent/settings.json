{
  "agentSettings": {
    "name": "DailyProjectChecklistAgent",
    "schemaVersion": "1.0",
    "conversationSettings": {
      "enableSmallTalk": true,
      "enableGenerativeAnswers": true,
      "responseStyle": "friendly",
      "maxTurnsPerConversation": 50
    },
    "securitySettings": {
      "requireAuthentication": true,
      "allowedAuthenticationProviders": ["AzureAD"],
      "dataResidency": "default"
    },
    "integrationSettings": {
      "notion": {
        "enabled": true,
        "syncInterval": "realtime",
        "defaultDatabase": "",
        "taskStatusMapping": {
          "notStarted": ["Not started", "To Do", "Backlog"],
          "inProgress": ["In progress", "Doing", "Working"],
          "completed": ["Done", "Complete", "Finished"]
        }
      },
      "planner": {
        "enabled": true,
        "syncInterval": "realtime",
        "defaultPlanId": "",
        "includeBuckets": true,
        "taskStatusMapping": {
          "notStarted": "notStarted",
          "inProgress": "inProgress",
          "completed": "completed"
        }
      }
    },
    "emailMonitoring": {
      "enabled": true,
      "provider": "outlook",
      "trigger": "flagged",
      "pollIntervalMinutes": 5,
      "monitoredFolders": ["Inbox"],
      "taskCreation": {
        "defaultStatus": "Not started",
        "sourceLabel": "Email",
        "priorityMapping": {
          "high": "high",
          "normal": "medium",
          "low": "low"
        },
        "bodySnippetMaxChars": 500,
        "markEmailAsRead": true,
        "tagEmailCategory": "Notion Task Created"
      },
      "notionFieldMapping": {
        "title": "email_subject",
        "priority": "email_importance",
        "source": "Email",
        "from": "sender_name_and_address",
        "emailLink": "email_web_link",
        "received": "email_received_datetime"
      }
    },
    "checklistSettings": {
      "defaultView": "combined",
      "sortOrder": "priority",
      "showCompletedTasks": false,
      "groupBySource": true,
      "dailyResetTime": "00:00",
      "timezone": "UTC"
    }
  }
}
