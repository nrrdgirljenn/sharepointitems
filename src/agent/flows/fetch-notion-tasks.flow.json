{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
      "flowId": "fetch-notion-tasks",
      "displayName": "Fetch Notion Tasks",
      "description": "Retrieves tasks from a Notion database for the daily checklist",
      "author": "Daily Project Checklist Agent",
      "version": "1.0.0"
    },
    "parameters": {
      "notionConnection": {
        "type": "string",
        "defaultValue": "notion-connection"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "PowerVirtualAgents",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "databaseId": {
                "type": "string",
                "description": "Notion database ID to query"
              },
              "filterStatus": {
                "type": "string",
                "description": "Status filter (active, completed, all)",
                "default": "active"
              },
              "includeDueToday": {
                "type": "boolean",
                "description": "Include tasks due today",
                "default": true
              },
              "testConnection": {
                "type": "boolean",
                "description": "Just test the connection",
                "default": false
              }
            },
            "required": ["databaseId"]
          }
        }
      }
    },
    "actions": {
      "Initialize_Results": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "taskResults",
              "type": "array",
              "value": []
            }
          ]
        },
        "runAfter": {}
      },
      "Query_Notion_Database": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "https://api.notion.com/v1/databases/@{triggerBody()?['databaseId']}/query",
          "headers": {
            "Authorization": "Bearer @{parameters('notionApiKey')}",
            "Notion-Version": "2022-06-28",
            "Content-Type": "application/json"
          },
          "body": {
            "filter": {
              "and": [
                {
                  "property": "Status",
                  "status": {
                    "does_not_equal": "Done"
                  }
                },
                {
                  "or": [
                    {
                      "property": "Due Date",
                      "date": {
                        "on_or_before": "@{utcNow()}"
                      }
                    },
                    {
                      "property": "Due Date",
                      "date": {
                        "equals": "@{formatDateTime(utcNow(), 'yyyy-MM-dd')}"
                      }
                    }
                  ]
                }
              ]
            },
            "sorts": [
              {
                "property": "Priority",
                "direction": "ascending"
              },
              {
                "property": "Due Date",
                "direction": "ascending"
              }
            ]
          }
        },
        "runAfter": {
          "Initialize_Results": ["Succeeded"]
        }
      },
      "Parse_Notion_Response": {
        "type": "ParseJson",
        "inputs": {
          "content": "@body('Query_Notion_Database')",
          "schema": {
            "type": "object",
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "properties": { "type": "object" }
                  }
                }
              },
              "has_more": { "type": "boolean" }
            }
          }
        },
        "runAfter": {
          "Query_Notion_Database": ["Succeeded"]
        }
      },
      "Transform_Tasks": {
        "type": "Select",
        "inputs": {
          "from": "@body('Parse_Notion_Response')?['results']",
          "select": {
            "id": "@item()?['id']",
            "title": "@{first(item()?['properties']?['Name']?['title'])?['plain_text']}",
            "status": "@item()?['properties']?['Status']?['status']?['name']",
            "priority": "@{coalesce(item()?['properties']?['Priority']?['select']?['name'], 'medium')}",
            "dueDate": "@{coalesce(item()?['properties']?['Due Date']?['date']?['start'], 'No due date')}",
            "source": "Notion",
            "url": "@item()?['url']",
            "lastEdited": "@item()?['last_edited_time']"
          }
        },
        "runAfter": {
          "Parse_Notion_Response": ["Succeeded"]
        }
      },
      "Response": {
        "type": "Response",
        "kind": "PowerVirtualAgents",
        "inputs": {
          "statusCode": 200,
          "body": {
            "notionTasks": "@body('Transform_Tasks')",
            "taskCount": "@length(body('Transform_Tasks'))",
            "errorMessage": null,
            "lastSync": "@utcNow()"
          }
        },
        "runAfter": {
          "Transform_Tasks": ["Succeeded"]
        }
      },
      "Error_Response": {
        "type": "Response",
        "kind": "PowerVirtualAgents",
        "inputs": {
          "statusCode": 200,
          "body": {
            "notionTasks": [],
            "taskCount": 0,
            "errorMessage": "Failed to fetch tasks from Notion. Please check your connection settings.",
            "lastSync": null
          }
        },
        "runAfter": {
          "Query_Notion_Database": ["Failed", "TimedOut"]
        }
      }
    },
    "outputs": {
      "notionTasks": {
        "type": "array",
        "description": "Array of tasks from Notion"
      },
      "taskCount": {
        "type": "integer",
        "description": "Number of tasks retrieved"
      },
      "errorMessage": {
        "type": "string",
        "description": "Error message if any"
      },
      "lastSync": {
        "type": "string",
        "description": "Timestamp of last sync"
      }
    }
  }
}
